{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["svelte", "vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
